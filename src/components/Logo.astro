---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../config/site';

// Usa o arquivo real da logo (fundo branco removido, arte intacta).
// O arquivo é servido/otimizado pelo Astro (`astro:assets`).
// NÃO recriar/modificar/recolorir a logomarca.

interface Props {
  /** Classes de tamanho da imagem (default: tamanho do header). */
  class?: string;
}

const { class: className = 'h-14 w-auto md:h-16' } = Astro.props;
---

<a href="/" class="block shrink-0" aria-label={`${site.name} — página inicial`}>
  <Image src={logo} alt="" class={className} loading="eager" fetchpriority="high" />
</a>
