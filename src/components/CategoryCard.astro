---
import type { Categoria } from '../data/categorias';
import PlaceholderImage from './PlaceholderImage.astro';

interface Props {
  categoria: Categoria;
}

const { categoria } = Astro.props;
---

<a
  href={`/presentes?categoria=${categoria.id}`}
  data-reveal
  class="group flex flex-col items-center gap-3 rounded-2xl p-2 text-center transition-transform duration-300 hover:-translate-y-1"
>
  <PlaceholderImage
    alt={categoria.imagemAlt}
    src={categoria.imagem}
    aspect="aspect-square"
    class="w-full"
  />
  <span class="font-serif text-lg text-graphite group-hover:text-institutional"
    >{categoria.nome}</span
  >
  <span
    class="text-[0.65rem] uppercase tracking-[0.2em] text-institutional/70 opacity-0 transition-opacity group-hover:opacity-100"
    >Ver presentes</span
  >
</a>
