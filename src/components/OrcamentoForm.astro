---
import { categorias } from '../data';
import { site } from '../config/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const waFallback = buildWhatsAppUrl(
  'Olá! Tentei enviar um pedido de orçamento pelo site da Presentear.',
);
const inputCls =
  'w-full rounded-lg border border-graphite/20 bg-white/70 px-3 py-2.5 text-graphite outline-none focus-visible:border-institutional';
const labelCls = 'block text-sm font-medium text-graphite';
---

<form id="form-orcamento" novalidate class="grid gap-5" aria-describedby="status">
  <div>
    <label class={labelCls} for="nome">Nome*</label>
    <input id="nome" name="nome" type="text" autocomplete="name" class={inputCls} />
    <p id="erro-nome" class="mt-1 text-sm text-terracotta" hidden></p>
  </div>

  <div>
    <label class={labelCls} for="whatsapp">WhatsApp*</label>
    <input
      id="whatsapp"
      name="whatsapp"
      type="tel"
      inputmode="tel"
      autocomplete="tel"
      placeholder="(48) 99999-9999"
      class={inputCls}
    />
    <p id="erro-whatsapp" class="mt-1 text-sm text-terracotta" hidden></p>
  </div>

  <div>
    <label class={labelCls} for="ocasiao">Ocasião*</label>
    <select id="ocasiao" name="ocasiao" class={inputCls}>
      <option value="">Selecione…</option>
      {categorias.map((c) => <option value={c.id}>{c.nome}</option>)}
    </select>
    <p id="erro-ocasiao" class="mt-1 text-sm text-terracotta" hidden></p>
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={labelCls} for="data">Data desejada</label>
      <input id="data" name="data" type="date" class={inputCls} />
    </div>
    <div>
      <label class={labelCls} for="faixa">Faixa de investimento</label>
      <input
        id="faixa"
        name="faixa"
        type="text"
        placeholder="Opcional"
        class={inputCls}
      />
    </div>
  </div>

  <div>
    <label class={labelCls} for="descricao">Conte o que você procura</label>
    <textarea id="descricao" name="descricao" rows="4" class={inputCls}></textarea>
  </div>

  <!-- honeypot anti-spam: deve ficar vazio -->
  <div class="hidden" aria-hidden="true">
    <label for="empresa">Empresa</label>
    <input id="empresa" name="empresa" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button
      type="submit"
      class="rounded-full bg-institutional px-7 py-3.5 text-sm font-medium uppercase tracking-wide text-cream transition-colors hover:bg-institutional-deep"
    >
      Enviar pedido
    </button>
    <a
      id="wa-fallback"
      href={waFallback}
      target="_blank"
      rel="noopener"
      data-track="cta_whatsapp"
      class="text-sm font-medium text-institutional underline underline-offset-4"
      hidden>Prefiro falar no WhatsApp</a
    >
  </div>

  <p id="status" role="status" aria-live="polite" class="text-sm text-graphite/80"></p>
</form>

<script>
  import '../scripts/orcamento';
</script>
