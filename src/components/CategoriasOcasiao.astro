---
import { categorias } from '../data';
import CategoryCard from './CategoryCard.astro';
---

<section id="ocasioes" class="bg-cream py-16 md:py-24" data-section="categorias">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="font-serif text-3xl text-graphite md:text-4xl" data-reveal>
      Encontre o presente ideal
    </h2>
    <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
      {categorias.map((c) => <CategoryCard categoria={c} />)}
    </div>
  </div>
</section>
