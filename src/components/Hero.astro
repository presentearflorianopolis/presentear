---
import { site } from '../config/site';
import { comBase } from '../lib/base';
import PlaceholderImage from './PlaceholderImage.astro';
import destaque from '../assets/produtos/caixa-presente.jpg';
---

<section class="relative overflow-hidden bg-cream" data-section="hero">
  <div
    class="mx-auto grid max-w-6xl items-center gap-8 px-4 pb-16 pt-32 md:grid-cols-2 md:gap-12 md:pb-24 md:pt-40"
  >
    <div class="order-2 md:order-1" data-reveal>
      <h1 class="font-serif text-4xl leading-[1.05] text-graphite sm:text-5xl md:text-6xl">
        {site.mensagemPrincipal}
      </h1>
      <p class="mt-5 max-w-md text-base text-graphite/75 md:text-lg">
        {site.mensagemComplementar}
      </p>
      <a
        href={comBase('/presentes')}
        class="mt-8 inline-flex rounded-full bg-institutional px-7 py-3.5 text-sm font-medium uppercase tracking-wide text-cream transition-colors hover:bg-institutional-deep"
      >
        {site.textos.heroCta}
      </a>
    </div>

    <div class="order-1 md:order-2" data-reveal data-reveal-delay="150">
      <PlaceholderImage
        alt="Cesta de celebração da Presentear com espumante"
        src={destaque}
        aspect="aspect-[4/5]"
        class="w-full"
      />
    </div>
  </div>
</section>
