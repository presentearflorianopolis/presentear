---
import { produtos } from '../data';
import ProductCard from './ProductCard.astro';
---

<section id="presentes" class="bg-cream py-16 md:py-24" data-section="presentes">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="font-serif text-3xl text-graphite md:text-4xl" data-reveal>Escolhas que encantam</h2>
    <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {produtos.map((p) => <ProductCard produto={p} />)}
    </div>
  </div>
</section>
