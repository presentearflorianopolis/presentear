---
import { site } from '../config/site';
import { buildWhatsAppUrl } from '../lib/whatsapp';

const whatsappUrl = buildWhatsAppUrl(
  'Olá! Vim pelo site da Presentear e gostaria de falar com vocês.',
);
---

<section id="contato-final" class="bg-beige/30 py-16 text-center md:py-24" data-section="cta-final">
  <div class="mx-auto max-w-3xl px-4" data-reveal>
    <h2 class="font-serif text-3xl text-graphite md:text-5xl">{site.textos.ctaFinalTitulo}</h2>
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener"
      data-track="cta_whatsapp"
      class="mt-8 inline-flex rounded-full bg-institutional px-8 py-4 text-sm font-medium uppercase tracking-wide text-cream transition-colors hover:bg-institutional-deep"
    >
      {site.textos.ctaFinalBotao}
    </a>
  </div>
</section>
