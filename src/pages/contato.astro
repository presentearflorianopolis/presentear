---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import OrcamentoForm from '../components/OrcamentoForm.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Contato e orçamento — Presentear Florianópolis"
  description="Solicite um orçamento de presente personalizado em Florianópolis ou fale com a Presentear pelo WhatsApp. Responderemos com informações e disponibilidade."
>
  <Header />
  <main class="pt-28">
    <section class="mx-auto max-w-2xl px-4 py-12 md:py-16">
      <h1 class="font-serif text-4xl text-graphite md:text-5xl">Solicite seu orçamento</h1>
      <p class="mt-3 text-graphite/70">
        Conte um pouco sobre a ocasião e a gente retorna com as opções. Prefere agilidade? Fale
        direto no WhatsApp {site.whatsappDisplay}.
      </p>
      <div class="mt-8">
        <OrcamentoForm />
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
