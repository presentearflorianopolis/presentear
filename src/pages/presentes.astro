---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProductCard from '../components/ProductCard.astro';
import { produtos } from '../data';
---

<BaseLayout
  title="Presentes — Presentear Florianópolis"
  description="Conheça as caixas de presente da Presentear: Caixa Presente, Caixa Sossego e Caixa com Bolo. Sem compra online — o atendimento é pelo WhatsApp."
>
  <Header />
  <main class="pt-28">
    <section class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <h1 class="font-serif text-4xl text-graphite md:text-5xl">Presentes</h1>
      <p class="mt-3 max-w-xl text-graphite/70">
        Sem compra online — escolha o presente e fale com a gente pelo WhatsApp.
      </p>

      <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {produtos.map((p) => <ProductCard produto={p} />)}
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
